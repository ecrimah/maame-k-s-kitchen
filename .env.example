# =============================================================================
# Maame K's Kitchen — environment template (no real secrets)
# Plain Postgres (VPS) cutover: set DATABASE_URL + point supabase-js at this app.
# =============================================================================

# --- App ---
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://maamekskitchen.ca
NEXT_PUBLIC_SITE_NAME=maamekskitchen
PORT=3000

# --- Store Contact ---
NEXT_PUBLIC_STORE_PHONE=5875822421
NEXT_PUBLIC_STORE_EMAIL=hello@maamekskitchen.ca
NEXT_PUBLIC_STORE_ADDRESS=Cornerstone, NE Calgary
NEXT_PUBLIC_STORE_CITY=Calgary
NEXT_PUBLIC_STORE_REGION=Alberta
NEXT_PUBLIC_STORE_COUNTRY=Canada
DEFAULT_COUNTRY_CODE=1

# --- Plain Postgres ---
DATABASE_URL=postgresql://store_maameks:CHANGE_ME@127.0.0.1:5432/store_maameks
# POSTGRES_URL=  # optional alias
PG_POOL_MAX=10
PGSSL=          # set to "require" if TLS is needed

# Dual-mode flags
NEXT_PUBLIC_USE_PLAIN_PG=true

# Browser supabase-js must target THIS app origin in plain-PG mode
# (hits /auth/v1, /rest/v1, /storage/v1 shims)
NEXT_PUBLIC_SUPABASE_URL=https://maamekskitchen.ca
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-or-any-nonempty-string
# Optional: used by REST ACL for service-role bypass on server jobs
SUPABASE_SERVICE_ROLE_KEY=service-role-or-strong-random-string

# Auth JWT (required in production — do not use the dev fallback)
AUTH_JWT_SECRET=generate-a-long-random-secret
# JWT_SECRET=
# SUPABASE_JWT_SECRET=

# --- Local disk storage (replaces Supabase Storage) ---
STORAGE_ROOT=/data/maameks/storage
STORAGE_PUBLIC_URL=https://maamekskitchen.ca
STORAGE_SIGNING_SECRET=generate-a-long-random-secret

# --- Payments - Stripe (primary gateway for this store) ---
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
# Webhook events: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid

# --- Moolre SMS (optional — SMS only; this store does NOT use Moolre payments) ---
# MOOLRE_SMS_API_KEY=
# MOOLRE_API_KEY=           # fallback for SMS only
# SMS_SENDER_ID=MaameKitch
# MOOLRE_SMS_SENDER_ID=MaameKitch

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Maame K's Kitchen <noreply@maamekskitchen.ca>
ADMIN_EMAIL=hello@maamekskitchen.ca

# --- Cron ---
# CRON_SECRET=generate-a-long-random-secret

# --- reCAPTCHA (optional) ---
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# --- Analytics (optional) ---
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Admin user creation (`npm run create-admin` only) ---
CREATE_ADMIN_EMAIL=admin@maamekskitchen.ca
CREATE_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# Hubtel / Paystack payment gateways: NOT implemented in this codebase.
# Moolre is used for SMS only (not checkout payments).
