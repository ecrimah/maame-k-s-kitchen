{
  "name": "maame-ks-kitchen",
  "version": "0.1.0",
  "private": true,
  "description": "Authentic Ghanaian cuisine in Calgary — order banku, jollof, waakye, fufu, and more for delivery or pickup.",
  "author": "Maame K <hello@maamekskitchen.ca>",
  "license": "Proprietary - All Rights Reserved",
  "homepage": "https://maamekskitchen.ca",
  "repository": {
    "type": "git",
    "url": "https://github.com/maamekskitchen/maame-ks-kitchen.git"
  },
  "bugs": {
    "url": "https://github.com/maamekskitchen/maame-ks-kitchen/issues"
  },
  "keywords": [
    "ghanaian-food",
    "restaurant",
    "your-city",
    "alberta",
    "ecommerce",
    "nextjs",
    "supabase"
  ],
  "scripts": {
    "build": "next build",
    "compress-images": "node scripts/compress-images.mjs",
    "dev": "cross-env NODE_ENV=development next dev -H 0.0.0.0 -p 3004",
    "lint": "next lint",
    "supabase:link": "supabase link --project-ref $SUPABASE_PROJECT_REF",
    "supabase:push": "supabase db push",
    "supabase:migrate": "supabase link --project-ref $SUPABASE_PROJECT_REF && supabase db push",
    "db:migrate": "node scripts/run-migration.mjs",
    "create-admin": "node scripts/create-admin-user.mjs",
    "start": "next start -H 0.0.0.0 -p 3000"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.19.3",
    "@supabase/supabase-js": "^2.91.1",
    "next": "15.1.11",
    "pg": "^8.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.2",
    "resend": "^6.9.1",
    "sharp": "^0.34.5",
    "stripe": "^18.0.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.5",
    "supabase": "^2.76.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.10",
    "dotenv-cli": "^7.4.2"
  }
}
